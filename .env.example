APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=herohub
DB_USERNAME=root
DB_PASSWORD=

# Digital membership card title (customer portal + PDF)
# HERO_CARD_COMPANY_NAME="HERO Client Rescue S.A."
# Optional absolute logo URL for branded emails
# HERO_MAIL_BRAND_LOGO_URL=https://www.heroclientrescue.com/path/to/logo.png

# Optional: link a demo membership to this user if they have none (with BindDemoMembershipSeeder)
# HERO_BIND_MEMBERSHIP_EMAIL=you@example.com

# Website/payment gateway → portal: POST JSON to {APP_URL}/api/v1/webhooks/subscription
# Header: X-Hero-Webhook-Secret: <same value>   (or Authorization: Bearer <same value>)
# HERO_WEBHOOK_SECRET=use-a-long-random-string
# HERO_WEBHOOK_AUTO_CREATE_USERS=true
# HERO_WEBHOOK_NEW_MEMBERSHIP_MAIL=true
# Coverage information is collected inside authenticated profile pages (no public webhook endpoint).

# Optional: customer billing portal URL (shown when changing plan / checkout)
# BILLING_CUSTOMER_PORTAL_URL=https://billing.example.com/portal/yourorg

# Stripe (membership plan change — Checkout). When STRIPE_SECRET is set, upgrade/downgrade uses Stripe checkout.
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# USA Payments (membership renewal + plan change — Collect.js). Same keys as the AWS payment-gateway app.
# USA_PAYMENTS_SECURITY_KEY=
# USA_DATA_TOKENIZATION_KEY=
# USA_PAYMENTS_TAX_RATE=0.10

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Database-backed sessions (requires `sessions` table — php artisan migrate).
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@heroclientrescue.com"
MAIL_FROM_NAME="HERO Client Rescue S.A."
# Optional SMTP EHLO domain (recommended for deliverability)
# MAIL_EHLO_DOMAIN=heroclientrescue.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
